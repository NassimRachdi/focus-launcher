<?xml version="1.0" encoding="utf-8"?>
<!-- Écran 800x480 (mdpi : 1 dp = 1 px). Aplats uniquement : pas d'ombre, pas de flou. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/fBg"
    android:orientation="horizontal">

    <!-- ===== Barre latérale ===== -->
    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:background="?attr/fPanel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <TextView android:id="@+id/nav_home" style="@style/RailBtn" android:drawableTop="@drawable/ic_home" android:text="Accueil" android:paddingTop="8dp" />
        <TextView android:id="@+id/nav_music" style="@style/RailBtn" android:drawableTop="@drawable/ic_music" android:text="Musique" android:paddingTop="8dp" />
        <TextView android:id="@+id/nav_car" style="@style/RailBtn" android:drawableTop="@drawable/ic_car" android:text="Voiture" android:paddingTop="8dp" />
        <TextView android:id="@+id/nav_apps" style="@style/RailBtn" android:drawableTop="@drawable/ic_apps" android:text="Applis" android:paddingTop="8dp" />

        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/nav_mode" style="@style/RailBtn" android:drawableTop="@drawable/ic_moon" android:text="Nuit" android:paddingTop="8dp" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/fLine" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ===== Barre d'état ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Ford Focus" android:textColor="?attr/fMute" android:textSize="13sp" />

            <TextView android:id="@+id/st_update" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="14dp" android:text="Mise à jour disponible" android:textColor="@color/accent"
                android:textSize="13sp" android:textStyle="bold" android:visibility="gone" android:clickable="true" />

            <TextView android:id="@+id/st_obd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="14dp" android:drawableStart="@drawable/dot_off" android:drawablePadding="5dp"
                android:gravity="center_vertical" android:text="OBD" android:textColor="?attr/fMute" android:textSize="13sp" android:clickable="true" />

            <TextView android:id="@+id/st_src" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="14dp" android:text="Bluetooth" android:textColor="?attr/fMute" android:textSize="13sp" />

            <TextView android:id="@+id/st_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--:--" android:textColor="?attr/fMute" android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/fLine" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

            <!-- ================= ACCUEIL ================= -->
            <LinearLayout android:id="@+id/page_home" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:padding="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05"
                        android:layout_marginEnd="10dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp">
                        <TextView android:id="@+id/home_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:text="--:--"
                            android:textColor="?attr/fTxt" android:textSize="64sp" />
                        <TextView android:id="@+id/home_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textColor="?attr/fMute" android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="110dp" android:layout_height="110dp" android:background="@drawable/bg_cover">
                            <ImageView android:id="@+id/home_cover_ph" android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center"
                                android:alpha="0.8" android:src="@drawable/ic_note" />
                            <ImageView android:id="@+id/home_cover" android:layout_width="match_parent" android:layout_height="match_parent"
                                android:scaleType="centerCrop" android:visibility="gone" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="14dp" android:orientation="vertical">
                            <TextView android:id="@+id/home_src" style="@style/T.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="En lecture" />
                            <TextView android:id="@+id/home_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                                android:ellipsize="end" android:singleLine="true" android:text="Aucune lecture" android:textColor="?attr/fTxt" android:textSize="19sp" android:textStyle="bold" />
                            <TextView android:id="@+id/home_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:ellipsize="end" android:singleLine="true" android:textColor="?attr/fMute" android:textSize="14sp" />
                            <ProgressBar android:id="@+id/home_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp"
                                android:layout_marginTop="10dp" android:max="1000" android:progressDrawable="@drawable/progress_bar" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp">
                                <TextView android:id="@+id/home_cur" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="?attr/fMute" android:textSize="11sp" />
                                <TextView android:id="@+id/home_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="?attr/fMute" android:textSize="11sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                                <ImageButton android:id="@+id/home_prev" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_round" android:src="@drawable/ic_prev" android:tint="?attr/fTxt" android:scaleType="center" />
                                <ImageButton android:id="@+id/home_pp" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_round_accent" android:src="@drawable/ic_play" android:scaleType="center" />
                                <ImageButton android:id="@+id/home_next" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_round" android:src="@drawable/ic_next" android:tint="?attr/fTxt" android:scaleType="center" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Indicateurs OBD -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temp. moteur" />
                        <TextView android:id="@+id/h_temp" style="@style/T.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Batterie" />
                        <TextView android:id="@+id/h_volt" style="@style/T.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Régime" />
                        <TextView android:id="@+id/h_rpm" style="@style/T.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diagnostic" />
                        <TextView android:id="@+id/h_diag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:singleLine="true" android:text="--" android:textColor="?attr/fMute" android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Raccourcis -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="10dp"
                    android:layout_marginStart="-5dp" android:layout_marginEnd="-5dp" android:orientation="horizontal">
                    <TextView android:id="@+id/dock_carplay" style="@style/Tile" android:background="@drawable/bg_accent" android:drawableTop="@drawable/ic_carplay" android:text="CarPlay" android:textColor="@color/white" />
                    <TextView android:id="@+id/dock_nav" style="@style/Tile" android:drawableTop="@drawable/ic_nav" android:text="Navigation" />
                    <TextView android:id="@+id/dock_radio" style="@style/Tile" android:drawableTop="@drawable/ic_radio" android:text="Radio" />
                    <TextView android:id="@+id/dock_phone" style="@style/Tile" android:drawableTop="@drawable/ic_phone" android:text="Téléphone" />
                    <TextView android:id="@+id/dock_video" style="@style/Tile" android:drawableTop="@drawable/ic_video" android:text="Vidéo" />
                    <TextView android:id="@+id/dock_all" style="@style/Tile" android:drawableTop="@drawable/ic_more" android:text="Toutes" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= MUSIQUE ================= -->
            <LinearLayout android:id="@+id/page_music" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:visibility="gone">

                <LinearLayout android:layout_width="230dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                    <FrameLayout android:layout_width="206dp" android:layout_height="206dp" android:background="@drawable/bg_cover">
                        <ImageView android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center" android:alpha="0.8" android:src="@drawable/ic_note" />
                        <ImageView android:id="@+id/m_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
                    </FrameLayout>
                    <TextView android:id="@+id/m_src" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/dot_ok" android:drawablePadding="6dp" android:gravity="center_vertical" android:text="Bluetooth" android:textColor="?attr/fMute" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="En lecture" />
                    <TextView android:id="@+id/m_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true"
                        android:text="Aucune lecture" android:textColor="?attr/fTxt" android:textSize="28sp" android:textStyle="bold" />
                    <TextView android:id="@+id/m_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true"
                        android:textColor="?attr/fMute" android:textSize="17sp" />
                    <ProgressBar android:id="@+id/m_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp"
                        android:layout_marginTop="22dp" android:max="1000" android:progressDrawable="@drawable/progress_bar" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/m_cur" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="?attr/fMute" android:textSize="11sp" />
                        <TextView android:id="@+id/m_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="?attr/fMute" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                        <ImageButton android:id="@+id/m_prev" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_round" android:src="@drawable/ic_prev" android:tint="?attr/fTxt" android:scaleType="center" />
                        <ImageButton android:id="@+id/m_pp" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="18dp" android:background="@drawable/bg_round_accent" android:src="@drawable/ic_play" android:scaleType="center" />
                        <ImageButton android:id="@+id/m_next" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="18dp" android:background="@drawable/bg_round" android:src="@drawable/ic_next" android:tint="?attr/fTxt" android:scaleType="center" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp">
                        <TextView android:id="@+id/m_carplay" style="@style/Chip" android:background="@drawable/bg_chip_accent" android:text="Ouvrir dans CarPlay" android:textColor="@color/white" />
                        <TextView android:id="@+id/m_radio" style="@style/Chip" android:text="Radio" />
                        <TextView android:id="@+id/m_files" style="@style/Chip" android:text="Fichiers SD / USB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= VOITURE ================= -->
            <LinearLayout android:id="@+id/page_car" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:padding="12dp" android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center_horizontal" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Température moteur" />
                        <fr.nassim.focuslauncher.GaugeView android:id="@+id/g_temp" android:layout_width="150dp" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/c_temp_u" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="°C" android:textColor="?attr/fMute" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:gravity="center_horizontal" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Régime" />
                        <fr.nassim.focuslauncher.GaugeView android:id="@+id/g_rpm" android:layout_width="150dp" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tr/min" android:textColor="?attr/fMute" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:gravity="center_horizontal" android:orientation="vertical">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tension batterie" />
                        <fr.nassim.focuslauncher.GaugeView android:id="@+id/g_volt" android:layout_width="150dp" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" />
                        <TextView android:id="@+id/c_volt_u" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V" android:textColor="?attr/fMute" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Charge moteur" />
                        <TextView android:id="@+id/c_load" style="@style/T.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="--" android:textSize="30sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Valeur OBD calculée" android:textColor="?attr/fMute" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Codes défaut" />
                        <TextView android:id="@+id/c_dtc" style="@style/T.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="--" android:textSize="30sp" />
                        <TextView android:id="@+id/c_dtc_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="En attente du scan" android:textColor="?attr/fMute" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:id="@+id/c_link_card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:clickable="true">
                        <TextView style="@style/T.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Liaison OBD" />
                        <TextView android:id="@+id/c_link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:drawableStart="@drawable/dot_off" android:drawablePadding="8dp"
                            android:gravity="center_vertical" android:text="Recherche…" android:textColor="?attr/fTxt" android:textSize="22sp" />
                        <TextView android:id="@+id/c_link_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Appui long : changer de mode" android:textColor="?attr/fMute" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= APPLIS ================= -->
            <GridView android:id="@+id/page_apps" android:layout_width="match_parent" android:layout_height="match_parent"
                android:numColumns="6" android:horizontalSpacing="10dp" android:verticalSpacing="10dp" android:padding="12dp"
                android:clipToPadding="false" android:listSelector="@android:color/transparent" android:scrollbars="none"
                android:stretchMode="columnWidth" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Toast maison (pas de Toast système, plus réactif) -->
</LinearLayout>
